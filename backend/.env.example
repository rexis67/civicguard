# Core
PORT=5000
NODE_ENV=development

# Public URL of the deployed frontend. Used in email verification links and as
# an allowed CORS origin. Required in production unless the host provides
# RENDER_EXTERNAL_URL (Render does). Never taken from the request Host header.
FRONTEND_URL=http://localhost:5173
# Optional public URL of the whole site (sitemap, canonical URLs). Falls back to
# FRONTEND_URL, then RENDER_EXTERNAL_URL.
PUBLIC_SITE_URL=
# Comma-separated list if you need more than one allowed browser origin.
# Browser origins that are not listed are denied by CORS.
CORS_ORIGINS=
# Optional absolute base URL for locally stored image links. Leave empty to use
# relative /uploads/... URLs, which work on any hostname or behind a proxy.
API_PUBLIC_BASE_URL=
# Set to false when a separate web server hosts the built frontend.
SERVE_STATIC=true

# AI triage
GEMINI_API_KEY=replace-with-your-gemini-key
# Model used for triage; override if a different model is available to your key.
GEMINI_MODEL=gemini-3.8-flash
# Milliseconds before a stalled triage is abandoned and the report is flagged.
ANALYSIS_TIMEOUT_MS=180000

# Auth
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTHORITY_INVITE_CODE=replace-with-a-private-invite-code
# Optional comma-separated email domains that may self-register as authority
# accounts without an invite code. Leave empty to require the code for everyone.
AUTHORITY_EMAIL_DOMAINS=
# Echo the verification link in the API response when SMTP is unavailable.
# Demo deployments only: the caller must prove the account password. Defaults
# to true outside production; never enable this on a public deployment.
RETURN_VERIFICATION_LINK=false

# Rate limits (per IP, 15 minute window for auth, 10 minutes for reports)
AUTH_RATE_LIMIT=60
LOGIN_RATE_LIMIT=10
REPORT_RATE_LIMIT=30

# Storage
CIVICGUARD_DB_PATH=./civicguard.sqlite
CIVICGUARD_REPORTS_PATH=./reports.json
# Set to true to load 12 pre-triaged demo incidents when the report store is
# empty. Never on a production deployment that receives real reports.
SEED_DEMO_DATA=false
# Set to 1 (or more) when running behind a reverse proxy / load balancer.
TRUST_PROXY_HOPS=0

# Email verification (required in production)
SMTP_HOST=smtp.example.gov
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=CivicGuard <no-reply@example.gov>

# Image storage: local for development, s3 for durable object storage
REPORT_IMAGE_STORAGE=local
UPLOAD_DIR=./uploads
S3_BUCKET=replace-with-bucket
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=https://cdn.example.com/civicguard
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
