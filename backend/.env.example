# Copy to backend/.env and replace every example value before deployment.

# Core server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=https://civicguard.example
SERVE_STATIC=true
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_BASE_URL=https://api.civicguard.example
# Public browser map key; restrict its provider-side referrers to your site domains.
MAPTILER_API_KEY=

# AI triage
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
ANALYSIS_TIMEOUT_MS=180000
ALERT_WEBHOOK_URL=

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTHORITY_INVITE_CODE=replace-with-a-private-invite-code
AUTHORITY_EMAIL_DOMAINS=example.gov
RETURN_VERIFICATION_LINK=false
AUTH_RATE_LIMIT=60
LOGIN_RATE_LIMIT=10
REPORT_RATE_LIMIT=5
CATEGORY_DEPARTMENTS={"pothole":"Roads & Infrastructure","streetlight":"Electrical Services","accessibility":"Accessibility Services","garbage":"Sanitation"}
SLA_HOURS_BY_SEVERITY={"1":120,"2":72,"3":48,"4":12,"5":4}

# SMTP email
SMTP_HOST=smtp.example.gov
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="CivicGuard <no-reply@example.gov>"

# Local storage and bootstrap
DB_PATH=./data/civicguard.db
CIVICGUARD_DB_PATH=./civicguard.sqlite
CIVICGUARD_REPORTS_PATH=./reports.json
CIVICGUARD_LEGACY_USERS_PATH=./users.json
SEED_DEMO_DATA=false
UPLOAD_DIR=./uploads
REPORT_IMAGE_STORAGE=local
TRUST_PROXY_HOPS=0

# S3-compatible image storage (only used when REPORT_IMAGE_STORAGE=s3)
S3_BUCKET=replace-with-bucket
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_BASE_URL=https://images.example.com
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
